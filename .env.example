NODE_ENV=development
PORT=3000
DATABASE_URL=
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
DB_POOL_MAX=10
PGSSL=false
# Pluggy começa no sandbox; nunca coloque estes segredos no frontend ou no Git.
OPEN_FINANCE_PROVIDER=pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_INCLUDE_SANDBOX=true
APP_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=Meu Dinheiro no Controle <noreply@example.com>
RESEND_API_KEY=
